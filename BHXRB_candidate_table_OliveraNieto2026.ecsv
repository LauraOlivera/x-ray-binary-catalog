# - {name: l, unit: deg, datatype: float64}
# - {name: b, unit: deg, datatype: float64}
# - {name: ra, unit: deg, datatype: float64}
# - {name: dec, unit: deg, datatype: float64}
# - {name: companion, datatype: string, description: low or high mass}
# - {name: Mcomp, unit: solMass, datatype: string, description: Companion mass}
# - {name: Mcomp_err, unit: solMass, datatype: float64}
# - {name: Mbh, unit: solMass, datatype: float64}
# - {name: MbhLimit, datatype: string, description: 'Black hole mass upper or lower limit?'}
# - {name: Mbh_errn, unit: solMass, datatype: float64}
# - {name: Mbh_errp, unit: solMass, datatype: float64}
# - {name: iLimit, datatype: string, description: 'Orbital inclination upper or lower limit?'}
# - {name: i, unit: deg, datatype: float64}
# - {name: i_errn, unit: deg, datatype: float64}
# - {name: i_errp, unit: deg, datatype: float64}
# - {name: PorbLimit, datatype: string, description: 'Orbital period upper or lower limit?'}
# - {name: Porb, unit: h, datatype: float64}
# - {name: Porb error, unit: h, datatype: float64}
# - {name: ref, datatype: string, description: Additional references other than those in the catalogs}
# - {name: radio ref, datatype: string, description: Reference for the radio flux}
# - {name: radio ref link, datatype: string, description: Link to the reference for the radio flux}
# - {name: jet position angle, unit: deg, datatype: float64}
# - {name: Lx (2-10 keV), unit: erg / s, datatype: float64}
# - {name: Lbol, unit: erg / s, datatype: float64}
# - {name: radio freq (hz), unit: Hz, datatype: float64}
# - {name: peak radio flux at freq (mJy), unit: mJy, datatype: float64}
